# ABS Production Routing Configuration

PassengerEnabled on
PassengerAppRoot /home/abshtuedu/abs_backend
PassengerAppType node
PassengerStartupFile app.js

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. EXCLUDE LMS SUBDOMAIN
  RewriteCond %{HTTP_HOST} ^lms\. [NC]
  RewriteRule .* - [L]

  # 2. DIRECT REWRITE FOR _NEXT STATIC ASSETS AND PUBLIC FILES
  RewriteRule ^_next/(.*)$ out/_next/$1 [L]
  RewriteRule ^logo\.png$ out/logo.png [L]
  RewriteRule ^favicon\.ico$ out/favicon.ico [L]

  # 3. SERVE PHYSICAL FILES DIRECTLY IF THEY EXIST ON DISK
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule .* - [L]

  # 4. ROUTE EVERYTHING ELSE TO NESTJS (ServeStaticModule handles HTML & API)
  RewriteRule ^(.*)$ app.js [L]
</IfModule>



