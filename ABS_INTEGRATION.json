				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"admissionId\": \"20261001\",\n  \"amount\": 3500.00,\n  \"reference\": \"BANK-TXN-9988\",\n  \"paidAt\": \"2026-04-29T10:00:00Z\"\n}"
				},
				"url": { "raw": "http://test.htu.edu.gh/api/webhooks/payment" }
			}
		},
		{
