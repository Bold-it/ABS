{
	"info": {
		"_postman_id": "abs-ropart-integration",
		"name": "ABS Ropat Integration (Bulk Mode)",
		"description": "Postman collection for integrating the Ropat Student Portal with the Auto Bridge Service (ABS). Contains all webhook triggers for student admissions, fee payments, course registrations, semester enrolments, semester drops, and graduation events.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Trigger New Admission",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "X-API-KEY", "value": "32b211c8bac34b69a303996dc2eb7640", "type": "text" },
					{ "key": "Content-Type", "value": "application/json", "type": "text" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"admissionId\": \"20261001\",\n  \"indexNumber\": \"0123456789\",\n  \"fullName\": \"Kofi Mensah\",\n  \"email\": \"k.mensah@personal-email.com\",\n  \"phone\": \"+233244000000\",\n  \"programme\": \"BSc Computer Science\",\n  \"level\": \"100\"\n}"
				},
				"url": { "raw": "http://test.htu.edu.gh/api/webhooks/admission" }
			}
		},
		{
			"name": "Trigger Payment Confirmation",
			"request": {
				"method": "POST",
				"header": [
